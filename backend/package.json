{
  "name": "@lasjijas/backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "express": "^4.21.0",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.41.0",
    "jsonwebtoken": "^9.0.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "zod": "^4.6.7",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/cookie-parser": "^1.4.8",
    "@types/node": "^22.0.0"
  }
}